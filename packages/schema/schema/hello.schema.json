{
  "type": "object",
  "required": [
    "deviceId",
    "fw",
    "schema",
    "board",
    "display",
    "widgets",
    "capacity",
    "capabilities"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]+$",
      "errorCode": "INVALID_DEVICE_ID",
      "description": "Same MAC-derived UUID the device uses as its SignalK access-request clientId."
    },
    "fw": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "schema": {
      "type": "object",
      "required": [
        "major"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "description": "Highest layout major the device parses."
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "string",
      "description": "Board/model name, e.g. \"waveshare-esp32-p4-86\"."
    },
    "display": {
      "type": "object",
      "required": [
        "width",
        "height",
        "rotation"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "rotation": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 270
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tile types and full-page widgets this firmware can render."
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Semantic font sizes."
    },
    "fontLineHeights": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Line heights in pixels of the fonts tile text can use, smallest first (ADR-0017). The editor sizes its preview text from them."
    },
    "capacity": {
      "type": "object",
      "required": [
        "psram"
      ],
      "properties": {
        "psram": {
          "type": "boolean"
        },
        "maxLayoutBytes": {
          "type": "integer",
          "minimum": 0
        },
        "freeHeapBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Measured by the device; the editor warns before sending a layout that will not fit."
    },
    "capabilities": {
      "type": "object",
      "required": [
        "touch",
        "put"
      ],
      "properties": {
        "touch": {
          "type": "boolean"
        },
        "put": {
          "type": "boolean"
        },
        "backlight": {
          "type": "boolean",
          "description": "The firmware can dim the backlight (settings.brightness)."
        }
      },
      "additionalProperties": false
    },
    "layoutEtag": {
      "type": "string",
      "description": "ETag of the cached layout, if any."
    },
    "recovery": {
      "type": "object",
      "required": [
        "skippedLayoutEtag"
      ],
      "properties": {
        "skippedLayoutEtag": {
          "type": "string",
          "description": "A layout that crashed the display while it was shown; the device refuses it until a different one is sent (ADR-0013)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://github.com/batuakan/ESPHelm/schema/hello/v1.json",
  "title": "ESPHelm device hello v1"
}
