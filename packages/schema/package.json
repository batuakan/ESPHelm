{
  "name": "@esphelm/schema",
  "version": "1.0.0",
  "description": "ESPHelm layout contract: TypeBox schema, JSON Schema, validator and shared unit table",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuakan/ESPHelm.git",
    "directory": "packages/schema"
  },
  "author": "Batu Akan",
  "homepage": "https://github.com/batuakan/ESPHelm#readme",
  "bugs": {
    "url": "https://github.com/batuakan/ESPHelm/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout.schema.json": "./schema/layout.schema.json",
    "./hello.schema.json": "./schema/hello.schema.json",
    "./units.json": "./units.json"
  },
  "files": [
    "dist",
    "schema",
    "generated",
    "units.json",
    "fixtures",
    "templates",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "generate": "tsx scripts/generate.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typebox": "1.3.36"
  },
  "keywords": [
    "esphelm",
    "signalk",
    "esp32",
    "esphome",
    "json-schema"
  ],
  "publishConfig": {
    "access": "public"
  }
}
