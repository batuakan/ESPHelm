{
  "version": 1,
  "id": "template-helm-720",
  "name": "Helm (large display)",
  "theme": "night",
  "pages": [
    {
      "kind": "grid",
      "id": "helm",
      "title": "Helm",
      "grid": { "cols": 4, "rows": 3 },
      "tiles": [
        {
          "type": "wind_rose", "id": "rose", "x": 0, "y": 0, "w": 2, "h": 2,
          "config": { "showTrueWind": true },
          "slots": {
            "center1": { "path": "navigation.speedOverGround", "unit": "kn", "decimals": 1, "label": "SOG" },
            "center2": { "path": "environment.wind.speedTrue", "unit": "kn", "decimals": 1, "label": "TWS" },
            "center3": { "path": "environment.wind.speedApparent", "unit": "kn", "decimals": 1, "label": "AWS" }
          }
        },
        { "type": "autopilot", "id": "autopilot", "x": 2, "y": 0, "w": 2, "h": 2 },
        { "type": "value", "id": "sog", "x": 0, "y": 2, "w": 1, "h": 1, "path": "navigation.speedOverGround", "unit": "kn", "decimals": 1, "label": "SOG", "history": true },
        { "type": "value", "id": "stw", "x": 1, "y": 2, "w": 1, "h": 1, "path": "navigation.speedThroughWater", "unit": "kn", "decimals": 1, "label": "STW" },
        { "type": "value", "id": "depth", "x": 2, "y": 2, "w": 1, "h": 1, "path": "environment.depth.belowTransducer", "unit": "m", "decimals": 1, "label": "Depth", "history": true },
        { "type": "value", "id": "cog", "x": 3, "y": 2, "w": 1, "h": 1, "path": "navigation.courseOverGroundTrue", "unit": "deg", "decimals": 0, "label": "COG" }
      ]
    }
  ]
}
