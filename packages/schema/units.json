{
  "$comment": "ESPHelm display units. Single source of truth for TS and firmware (run `npm run generate`). display = si * factor + offset, then wrapped into [wrap[0], wrap[1]) if wrap is set. `signalk` is the SignalK meta.units string of the quantity. Unit ids are globally unique ASCII identifiers; labels use only ASCII and the degree sign.",
  "version": 1,
  "quantities": {
    "speed": {
      "signalk": "m/s",
      "si": "mps",
      "units": {
        "mps": { "label": "m/s", "factor": 1 },
        "kn": { "label": "kn", "factor": 1.9438444924406046 },
        "kmh": { "label": "km/h", "factor": 3.6 },
        "mph": { "label": "mph", "factor": 2.2369362920544025 }
      }
    },
    "angle": {
      "signalk": "rad",
      "si": "rad",
      "units": {
        "rad": { "label": "rad", "factor": 1 },
        "deg": { "label": "°", "factor": 57.29577951308232, "wrap": [0, 360] },
        "deg180": { "label": "°", "factor": 57.29577951308232, "wrap": [-180, 180] }
      }
    },
    "angularVelocity": {
      "signalk": "rad/s",
      "si": "radps",
      "units": {
        "radps": { "label": "rad/s", "factor": 1 },
