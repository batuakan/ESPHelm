        "K": { "label": "K", "factor": 1 },
        "degC": { "label": "°C", "factor": 1, "offset": -273.15 },
        "degF": { "label": "°F", "factor": 1.8, "offset": -459.67 }
      }
    },
    "ratio": {
      "signalk": "ratio",
      "si": "ratio",
