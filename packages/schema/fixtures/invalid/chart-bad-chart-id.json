{
  "description": "Chart identifiers are URL-safe",
  "expect": [
    {
      "code": "INVALID_ID",
      "pointer": "/pages/0/tiles/0/chart"
    }
  ],
  "layout": {
    "version": 1,
    "id": "minimal",
    "theme": "day",
    "pages": [
      {
        "kind": "grid",
        "id": "p",
        "grid": {
          "cols": 1,
          "rows": 1
        },
        "tiles": [
          {
            "type": "chart",
            "id": "c",
            "x": 0,
            "y": 0,
            "w": 1,
            "h": 1,
            "chart": "../etc/passwd"
          }
        ]
      }
    ]
  }
}
