{
  "version": 1,
  "id": "value-history",
  "name": "Value history",
  "theme": "day",
  "pages": [
    {
      "kind": "grid",
      "id": "history",
      "title": "History",
      "grid": {
        "cols": 2,
        "rows": 2
      },
      "tiles": [
        {
          "type": "value",
          "id": "sog",
          "x": 0,
          "y": 0,
          "w": 2,
          "h": 1,
          "path": "navigation.speedOverGround",
          "label": "SOG",
          "unit": "kn"
        },
        {
          "type": "value",
          "id": "depth",
          "x": 0,
          "y": 1,
          "w": 1,
          "h": 1,
          "path": "environment.depth.belowTransducer",
          "label": "Depth",
          "unit": "m",
          "zones": [
            {
              "to": 3,
              "state": "alarm"
            },
            {
              "from": 3,
              "to": 5,
              "state": "warn"
            }
          ]
        },
        {
          "type": "value",
          "id": "hdg",
          "x": 1,
          "y": 1,
          "w": 1,
          "h": 1,
          "path": "navigation.headingTrue",
          "label": "HDG",
          "unit": "deg",
          "decimals": 0,
          "history": false
        }
      ]
    },
    {
      "kind": "grid",
      "id": "other",
      "title": "Other",
      "grid": {
        "cols": 1,
        "rows": 1
      },
      "tiles": [
        {
          "type": "value",
          "id": "water",
          "x": 0,
          "y": 0,
          "w": 1,
          "h": 1,
          "path": "environment.water.temperature",
          "label": "Water",
          "unit": "degC",
          "history": true
        }
      ]
    }
  ]
}
