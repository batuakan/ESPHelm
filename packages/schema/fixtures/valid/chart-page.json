{
  "version": 1,
  "id": "chart",
  "name": "Chart and anchor watch",
  "theme": "night",
  "pages": [
    { "kind": "chart", "id": "chart", "title": "Chart", "chart": "test-chart" },
    {
      "kind": "chart",
      "id": "anchor",
      "title": "Anchor",
      "chart": "OSM.raster_v2",
      "zoom": 17,
      "anchor": true,
      "config": {
        "positionPath": "navigation.position",
        "headingPath": "navigation.headingMagnetic",
        "anchorPositionPath": "navigation.anchor.position",
        "anchorRadiusPath": "navigation.anchor.maxRadius",
        "anchorAlarmPath": "notifications.navigation.anchor"
      }
    },
    {
      "kind": "grid",
      "id": "speeds",
      "grid": { "cols": 1, "rows": 1 },
      "tiles": [{ "type": "value", "id": "sog", "x": 0, "y": 0, "w": 1, "h": 1, "path": "navigation.speedOverGround", "unit": "kn" }]
    }
  ]
}
